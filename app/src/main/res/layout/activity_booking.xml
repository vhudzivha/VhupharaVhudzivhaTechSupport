<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <Button
            android:id="@+id/tvBookingBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:text="← Back"
            android:textColor="#174A73"
            android:backgroundTint="#E1EAF2"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvBookingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Book a Service"
            android:textColor="#123B5D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBookingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tell us what IT service you need."
            android:textColor="#607080"
            android:textSize="15sp" />

        <!-- Service Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="SERVICE TYPE"
            android:textColor="#123B5D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spServiceType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />

        <!-- Date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PREFERRED DATE"
            android:textColor="#123B5D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBookingDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:focusable="false"
            android:hint="Select date"
            android:padding="16dp"
            android:textColor="#123B5D"
            android:textSize="15sp" />

        <!-- Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PREFERRED TIME"
            android:textColor="#123B5D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBookingTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:focusable="false"
            android:hint="Select time"
            android:padding="16dp"
            android:textColor="#123B5D"
            android:textSize="15sp" />

        <!-- Address -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SERVICE ADDRESS"
            android:textColor="#123B5D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBookingAddress"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="Enter service address"
            android:inputType="textPostalAddress"
            android:padding="16dp"
            android:textColor="#123B5D"
            android:textSize="15sp" />

        <!-- Problem Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PROBLEM DESCRIPTION"
            android:textColor="#123B5D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProblemDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Describe the IT problem or service you need"
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="#123B5D"
            android:textSize="15sp" />

        <!-- Book Button -->
        <Button
            android:id="@+id/btnBookService"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#123B5D"
            android:text="BOOK SERVICE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>