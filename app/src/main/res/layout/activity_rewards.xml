<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rewards &amp; Reviews"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#174A73"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Rewards -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR REWARDS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#174A73"/>

            <TextView
                android:id="@+id/pointsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reward Points: 100"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Earn points by completing services and providing feedback."
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Review -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RATE YOUR COMPLETED SERVICE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#174A73"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IT Support Booking #1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="12dp"/>

            <!-- Stars -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/star1"
                    android:layout_width="50dp"
                    android:layout_height="60dp"
                    android:text="☆"
                    android:textSize="42sp"
                    android:textColor="#6B607D"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/star2"
                    android:layout_width="50dp"
                    android:layout_height="60dp"
                    android:text="☆"
                    android:textSize="42sp"
                    android:textColor="#6B607D"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/star3"
                    android:layout_width="50dp"
                    android:layout_height="60dp"
                    android:text="☆"
                    android:textSize="42sp"
                    android:textColor="#6B607D"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/star4"
                    android:layout_width="50dp"
                    android:layout_height="60dp"
                    android:text="☆"
                    android:textSize="42sp"
                    android:textColor="#6B607D"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/star5"
                    android:layout_width="50dp"
                    android:layout_height="60dp"
                    android:text="☆"
                    android:textSize="42sp"
                    android:textColor="#6B607D"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <EditText
                android:id="@+id/reviewInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:hint="Write your review..."
                android:gravity="top"
                android:padding="12dp"
                android:background="#F4F4F4"
                android:inputType="textMultiLine"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/submitReviewButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUBMIT REVIEW"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#174A73"
                android:layout_marginTop="14dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#174A73"
            android:backgroundTint="#E1EAF2"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>